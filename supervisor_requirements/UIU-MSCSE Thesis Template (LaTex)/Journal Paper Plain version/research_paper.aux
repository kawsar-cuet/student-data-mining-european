\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {III-F}1}Component 1: LLM-Based Semantic Feature Extraction}{7}{subsubsection.3.6.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces AHFS-TA Framework Architecture with Stage-by-Stage Data Flow. The framework processes raw student data (34 features) through four sequential stages. Stage 1 (LLM Feature Extraction) enriches the data with four semantic features via DistilBERT embeddings. Stage 2 (Temporal Attention Network) captures semester-wise patterns using BiGRU and multi-head attention. Stage 3 (Adaptive Feature Selection) applies three-stream meta-ranking at epoch 10 to select the top 28 features. Stage 4 (Classification Head) produces final predictions with SHAP-based explainability for actionable insights.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:framework}{{3}{8}{AHFS-TA Framework Architecture with Stage-by-Stage Data Flow. The framework processes raw student data (34 features) through four sequential stages. Stage 1 (LLM Feature Extraction) enriches the data with four semantic features via DistilBERT embeddings. Stage 2 (Temporal Attention Network) captures semester-wise patterns using BiGRU and multi-head attention. Stage 3 (Adaptive Feature Selection) applies three-stream meta-ranking at epoch 10 to select the top 28 features. Stage 4 (Classification Head) produces final predictions with SHAP-based explainability for actionable insights}{figure.caption.6}{}}
