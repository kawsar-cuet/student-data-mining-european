\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Feature ranking heatmap across five methods (Information Gain, Gain Ratio, Gini Index, Chi-squared, F-statistic). Darker colors indicate higher importance rankings. This visualization enables comparison of feature importance consistency across different ranking methodologies, revealing that curricular unit performance and financial status features maintain high rankings across all five methods, demonstrating their robust predictive value for dropout detection.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ranking_heatmap}{{2}{6}{Feature ranking heatmap across five methods (Information Gain, Gain Ratio, Gini Index, Chi-squared, F-statistic). Darker colors indicate higher importance rankings. This visualization enables comparison of feature importance consistency across different ranking methodologies, revealing that curricular unit performance and financial status features maintain high rankings across all five methods, demonstrating their robust predictive value for dropout detection}{figure.caption.5}{}}
