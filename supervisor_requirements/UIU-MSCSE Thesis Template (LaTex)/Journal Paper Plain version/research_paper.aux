\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces 10-Fold cross-validation results showing accuracy distribution across folds for all models. (a) Box plots displaying median accuracy (center line), interquartile range (box), and outliers (whiskers) for each model. (b) Line plot showing fold-wise accuracy variation across all 10 folds for each model. AHFS-TA demonstrates the highest median accuracy (90.85\%) with the lowest variance ($\pm $0.92\%), indicating both superior performance and excellent generalization stability compared to baseline models.}}{13}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cv_results}{{4}{13}{10-Fold cross-validation results showing accuracy distribution across folds for all models. (a) Box plots displaying median accuracy (center line), interquartile range (box), and outliers (whiskers) for each model. (b) Line plot showing fold-wise accuracy variation across all 10 folds for each model. AHFS-TA demonstrates the highest median accuracy (90.85\%) with the lowest variance ($\pm $0.92\%), indicating both superior performance and excellent generalization stability compared to baseline models}{figure.caption.9}{}}
